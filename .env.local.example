# Upstash Redis / Vercel KV Configuration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback KV Environment Variables
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin Panel Password
ADMIN_PASSWORD=

# Newsletter (optional — enables real email confirmations)
RESEND_API_KEY=
NEWSLETTER_FROM=Ghibli Gazette <newsletter@yourdomain.com>

# Instant search (optional — falls back to local search)
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Public site URL (used for newsletter confirm links, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=https://ghibli-gazette.vercel.app